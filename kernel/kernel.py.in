from ipykernel.kernelbase import Kernel
import subprocess, tempfile, os, re, shutil, base64, threading, stat, uuid

# ── project paths — substituted by install_kernel.sh / Jupyter_c_kernels.sh ──
# Paths substituted by cmake configure_file — edit build/kernel/kernel.py.in, not this file.
INCLUDE_DIR = "@IMGPROC_INCLUDE_DIR@"
SRC_DIR     = "@IMGPROC_SRC_DIR@"
LIB_PATH    = "@IMGPROC_LIB_PATH@"

# ── kernel live dir = build/jupyter/  (this file's own directory) ─────────────
# The patched copy of this file lives at build/jupyter/kernel.py.
# build/jupyter/ also contains kernel.json and _shims/.
# The only kernel file outside build/ is the thin stub kernel.json at
# ~/.local/share/jupyter/kernels/c_imgproc/ which just points argv[1] here.
KERNEL_DIR  = os.path.dirname(os.path.abspath(__file__))
SHIM_DIR    = os.path.join(KERNEL_DIR, "_shims")
SHIM_SCRIPT = os.path.join(SHIM_DIR, "gnuplot")

COMPILE_FLAGS = [
    "-g3", "-O0", "-Wall",
    f"-I{INCLUDE_DIR}",
    f"-I{SRC_DIR}",
    "-std=c11",
]
LINK_FLAGS = [LIB_PATH, "-lfftw3", "-lm"]

GDB_AVAILABLE = shutil.which("gdb") is not None
GCC_AVAILABLE = shutil.which("gcc") is not None

RUN_TIMEOUT = 180   # seconds — raised for long parameter searches

AUTO_INCLUDES = [
    "#include <stdio.h>",
    "#include <stdlib.h>",
    "#include <string.h>",
    "#include <math.h>",
    "#include <time.h>",
    '#include "bmp.h"',
    '#include "imgproc.h"',
    '#include "transforms.h"',
]

# Prepended before all includes so POSIX types (struct timespec, etc.) are
# always available regardless of include order.  The #ifndef guard makes it
# safe even when the cell already defines _POSIX_C_SOURCE itself.
_POSIX_GUARD = "#ifndef _POSIX_C_SOURCE\n#define _POSIX_C_SOURCE 200809L\n#endif"

HELP_TEXT = """
┌──────────────────────────────────────────────────────────────────────────────┐
│             C (imgPrcsng) Kernel — Commands                                  │
├──────────────────────────────────────────────────────────────────────────────┤
│  %break <N>   pause at line N                                                │
│  %break <fn>  pause when function fn() is called                            │
│  %print <x>   print value of x when paused                                  │
│  %watch <x>   pause whenever variable x changes                             │
│  %clear       remove all breakpoints and watches                            │
│  %help        show this message                                              │
├──────────────────────────────────────────────────────────────────────────────┤
│  bmp.h / imgproc.h / transforms.h — prepended automatically                 │
│  Bare statements — wrapped in main() automatically                           │
│  Crashes — shown with GDB backtrace automatically                           │
│  gnuplot popen() — intercepted; every plot renders inline as PNG            │
│  Template : build/kernel.py   (edit this one)                                │
│  Live copy : build/jupyter/kernel.py  (written by install_kernel.sh)        │
└──────────────────────────────────────────────────────────────────────────────┘
"""

# ── gnuplot shim ───────────────────────────────────────────────────────────────
# Written to build/jupyter/_shims/gnuplot at first kernel launch.
# Placed first in PATH before every binary run so that any C call to
# popen("gnuplot ...", "w") execs this script instead of the real binary.
#
#   1. Strips -persist / --persist / -p  (X11 window requests).
#   2. Reads the gnuplot script from stdin.
#   3. Removes existing 'set terminal' / 'set output'; injects pngcairo.
#   4. Feeds the modified script to the real gnuplot (found via PATH_REAL).
#   5. Prints  __DISPLAY__:/tmp/jup_gp_<uuid>.png  to stdout.
#
# _run_streaming() intercepts __DISPLAY__: lines and renders them inline.
_SHIM_SOURCE = r"""#!/usr/bin/env python3
import sys, os, subprocess, uuid

def find_real_gnuplot():
    for directory in os.environ.get("PATH_REAL", "").split(os.pathsep):
        candidate = os.path.join(directory, "gnuplot")
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    return None

def main():
    skip = {"-persist", "--persist", "-p"}
    args = [a for a in sys.argv[1:] if a not in skip]

    try:
        raw_script = sys.stdin.read()
    except Exception:
        raw_script = ""

    out_png = f"/tmp/jup_gp_{uuid.uuid4().hex[:10]}.png"

    clean_lines = []
    for line in raw_script.splitlines():
        stripped = line.strip().lower()
        if stripped.startswith("set terminal") or stripped.startswith("set output"):
            continue
        clean_lines.append(line)

    modified = (
        f"set terminal pngcairo size 900,340 enhanced font 'Sans,10'\n"
        f"set output '{out_png}'\n"
        + "\n".join(clean_lines)
        + "\nset output\n"
    )

    real_gp = find_real_gnuplot()
    if real_gp is None:
        sys.stderr.write("gnuplot shim: real gnuplot not found in PATH_REAL\n")
        sys.exit(1)

    result = subprocess.run(
        [real_gp] + args,
        input=modified,
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        sys.stderr.write(result.stderr)
        sys.exit(result.returncode)

    if os.path.isfile(out_png) and os.path.getsize(out_png) > 0:
        print(f"__DISPLAY__:{out_png}", flush=True)

if __name__ == "__main__":
    main()
"""


def _install_shim():
    """Write the gnuplot shim to build/jupyter/_shims/ — idempotent."""
    os.makedirs(SHIM_DIR, exist_ok=True)
    current = ""
    if os.path.isfile(SHIM_SCRIPT):
        with open(SHIM_SCRIPT) as fh:
            current = fh.read()
    if current == _SHIM_SOURCE:
        return
    with open(SHIM_SCRIPT, "w") as fh:
        fh.write(_SHIM_SOURCE)
    os.chmod(SHIM_SCRIPT,
             stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP |
             stat.S_IROTH | stat.S_IXOTH)


def _run_env():
    """
    Environment for subprocess calls:
      PATH      — SHIM_DIR first so the fake gnuplot intercepts every exec
      PATH_REAL — original PATH so the shim can locate the real gnuplot
      DISPLAY   — removed to block X11 fallback
    """
    env = os.environ.copy()
    original = env.get("PATH", "")
    env["PATH"]      = SHIM_DIR + os.pathsep + original
    env["PATH_REAL"] = original
    env.pop("DISPLAY", None)
    return env


# ── source helpers ─────────────────────────────────────────────────────────────

def _has_main(src):
    # Explicit main()
    if re.search(r'\bmain\s*\(', src):
        return True
    # Function definitions: look for ){  or )\n{ where the ( is not
    # preceded by a control-flow keyword.  Walk backwards from ) to its
    # matching ( then check the identifier just before that (.
    _CTRL = frozenset('if for while switch else do'.split())
    for m in re.finditer(r'\)\s*\{', src):
        # Find the ( that matches the ) at m.start()
        depth, open_pos = 0, -1
        for i in range(m.start(), -1, -1):
            if src[i] == ')': depth += 1
            elif src[i] == '(':
                depth -= 1
                if depth == 0:
                    open_pos = i
                    break
        if open_pos < 0:
            continue
        # Grab the word immediately before the (
        before_paren = src[:open_pos].rstrip()
        word_m = re.search(r'\b(\w+)\s*$', before_paren)
        if word_m and word_m.group(1) in _CTRL:
            continue
        return True
    return False

def _has_include(src, header):
    bare = header.strip('<>"')
    return bool(re.search(r'#\s*include\s*[<"]' + re.escape(bare) + r'[>"]', src))

def _build_source(src):
    # _POSIX_GUARD always goes first so POSIX types are available
    # regardless of include order in either the auto-includes or the source.
    preamble = _POSIX_GUARD + "\n"

    if _has_main(src):
        # Source already has a main() — only prepend auto-includes that are
        # genuinely absent.  Do NOT extract pre_lines: doing so splits
        # multi-line #define macros (e.g. PRINT_LAP) from their continuation
        # lines and duplicates every # line that is already in src.
        missing = [inc for inc in AUTO_INCLUDES
                   if not _has_include(src, inc.split()[1])]
        header = preamble + "\n".join(missing) + "\n\n" if missing else preamble + "\n"
        return header + src

    # No main() — wrap bare statements.  Extract # lines so they appear at
    # file scope rather than inside the generated main().
    lines      = src.splitlines()
    pre_lines  = [l for l in lines if l.strip().startswith('#')]
    code_lines = [l for l in lines if not l.strip().startswith('#')]
    include_block = [inc for inc in AUTO_INCLUDES
                     if not _has_include(src, inc.split()[1])]
    include_block.extend(pre_lines)
    indented = "\n".join("    " + l if l.strip() else "" for l in code_lines)
    return (
        preamble + "\n".join(include_block) + "\n\n"
        + "int main(void) {\n"
        + indented
        + "\n    return 0;\n}\n"
    )


# ── kernel ─────────────────────────────────────────────────────────────────────

class CGDBKernel(Kernel):
    implementation         = "c_imgproc"
    implementation_version = "2.0"
    language               = "c"
    language_version       = "C11"
    language_info          = {
        "name": "c", "mimetype": "text/x-csrc", "file_extension": ".c"
    }
    banner = (
        "C (imgPrcsng) + GDB Kernel  v2  (gnuplot→inline)\n"
        f"  headers    : {INCLUDE_DIR}\n"
        f"  library    : {LIB_PATH}\n"
        f"  kernel dir : {KERNEL_DIR}\n"
        "  bmp.h / imgproc.h / transforms.h — auto-included\n"
        "  bare statements — auto-wrapped in main()\n"
        "  gnuplot popen() — intercepted, renders inline\n"
        "  type %help for debug commands\n"
    )

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self._breakpoints = []
        self._watches     = []
        _install_shim()

    def _send(self, text, stream="stdout"):
        if text:
            self.send_response(self.iopub_socket, "stream",
                               {"name": stream, "text": text})

    def _send_image(self, path):
        try:
            with open(path, "rb") as fh:
                b64 = base64.b64encode(fh.read()).decode()
            self.send_response(
                self.iopub_socket,
                "display_data",
                {
                    "data":      {"image/png": b64,
                                  "text/plain": f"[plot: {os.path.basename(path)}]"},
                    "metadata":  {},
                    "transient": {},
                },
            )
        except OSError as exc:
            self._send(f"[display] could not read {path}: {exc}\n", "stderr")

    def _bmp_to_b64_png(self, bmp_path):
        """
        Read a BMP file and return a base64-encoded PNG string, or None on error.
        Handles 8-bit grayscale and 24-bit colour BMPs written by writeBMP().
        Uses only Python stdlib — no Pillow or ImageMagick needed.
        """
        import struct, zlib

        def _write_png(w, h, rows_rgb):
            def chunk(tag, data):
                c = struct.pack(">I", len(data)) + tag + data
                return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
            raw = b"".join(b"\x00" + row for row in rows_rgb)
            return (b"\x89PNG\r\n\x1a\n"
                    + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
                    + chunk(b"IDAT", zlib.compress(raw, 6))
                    + chunk(b"IEND", b""))

        try:
            with open(bmp_path, "rb") as fh:
                data = fh.read()
            if len(data) < 54 or data[:2] != b"BM":
                return None
            pixel_offset = struct.unpack_from("<I", data, 10)[0]
            width        = struct.unpack_from("<i", data, 18)[0]
            height_raw   = struct.unpack_from("<i", data, 22)[0]
            bpp          = struct.unpack_from("<H", data, 28)[0]
            height       = abs(height_raw)
            bottom_up    = height_raw > 0
            rows_rgb = []
            if bpp == 24:
                rpitch = (width * 3 + 3) & ~3
                for ri in range(height):
                    sr = height - 1 - ri if bottom_up else ri
                    off = pixel_offset + sr * rpitch
                    bgr = data[off: off + width * 3]
                    rgb = bytearray(width * 3)
                    for j in range(width):
                        rgb[j*3]   = bgr[j*3+2]
                        rgb[j*3+1] = bgr[j*3+1]
                        rgb[j*3+2] = bgr[j*3]
                    rows_rgb.append(bytes(rgb))
            elif bpp == 8:
                palette = [(data[54+k*4+2], data[54+k*4+1], data[54+k*4])
                           for k in range(256)]
                rpitch = (width + 3) & ~3
                for ri in range(height):
                    sr = height - 1 - ri if bottom_up else ri
                    off = pixel_offset + sr * rpitch
                    rgb = bytearray(width * 3)
                    for j in range(width):
                        r, g, b = palette[data[off + j]]
                        rgb[j*3] = r; rgb[j*3+1] = g; rgb[j*3+2] = b
                    rows_rgb.append(bytes(rgb))
            else:
                return None
            return base64.b64encode(_write_png(width, height, rows_rgb)).decode()
        except Exception:
            return None

    def _send_bmp(self, bmp_path):
        """
        Display a single BMP inline.
        Emitted by C cells as:  printf("__DISPLAY_BMP__:%s\n", path);
        """
        b64 = self._bmp_to_b64_png(bmp_path)
        if b64 is None:
            self._send(f"[display] could not decode BMP: {bmp_path}\n", "stderr")
            return
        self.send_response(self.iopub_socket, "display_data", {
            "data":      {"image/png": b64,
                          "text/plain": f"[image: {os.path.basename(bmp_path)}]"},
            "metadata":  {},
            "transient": {},
        })

    def _send_bmp_row(self, line):
        """
        Display multiple BMPs side by side in a flex-row HTML layout.
        Protocol:  __DISPLAY_BMP_ROW__:path1|title1|path2|title2|...
        Paths and titles alternate; title may be empty.
        Emitted by C cells as:
            printf("__DISPLAY_BMP_ROW__:%s|%s|%s|%s\n",
                   path1, title1, path2, title2);
        """
        parts  = line.split("|")
        # pairs: (path, title)
        pairs  = [(parts[i], parts[i+1] if i+1 < len(parts) else "")
                  for i in range(0, len(parts), 2)]
        cells  = []
        for path, title in pairs:
            path = path.strip()
            if not path:
                continue
            b64 = self._bmp_to_b64_png(path)
            if b64 is None:
                cells.append(f'<div style="flex:1;text-align:center;font-size:11px;'
                             f'color:var(--color-text-secondary)">[could not load {os.path.basename(path)}]</div>')
                continue
            img_tag = f'<img src="data:image/png;base64,{b64}" style="max-width:100%;height:auto;display:block;">' 
            cap_tag = (f'<div style="font-size:11px;color:var(--color-text-secondary);'
                       f'margin-top:4px;text-align:center">{title}</div>') if title.strip() else ""
            cells.append(f'<div style="flex:1;min-width:0">{img_tag}{cap_tag}</div>')
        if not cells:
            return
        html = ('<div style="display:flex;gap:12px;align-items:flex-start;'
                'margin:4px 0">' + "".join(cells) + "</div>")
        self.send_response(self.iopub_socket, "display_data", {
            "data":      {"text/html": html,
                          "text/plain": f"[image row: {len(cells)} images]"},
            "metadata":  {},
            "transient": {},
        })

    def _ok(self):
        return {"status": "ok", "execution_count": self.execution_count,
                "payload": [], "user_expressions": {}}

    def _compile(self, src_path, binary_path):
        cmd = ["gcc"] + COMPILE_FLAGS + [src_path, "-o", binary_path] + LINK_FLAGS
        r   = subprocess.run(cmd, capture_output=True, text=True)
        return r.returncode == 0, r.stderr

    def _run_streaming(self, binary):
        """
        Run the compiled binary with Popen, streaming output line by line.
        __DISPLAY__:<path> lines are sent inline as PNG display_data.
        All other lines stream to the cell output in real time.
        stderr is drained by a background thread to prevent pipe deadlock.
        """
        env          = _run_env()
        stderr_lines = []

        proc = subprocess.Popen(
            [binary],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=env,
            text=True,
            bufsize=1,
        )

        def _drain_stderr():
            for line in proc.stderr:
                stderr_lines.append(line)
        t = threading.Thread(target=_drain_stderr, daemon=True)
        t.start()

        try:
            for line in proc.stdout:
                stripped = line.rstrip("\n").rstrip("\r")
                if stripped.startswith("__DISPLAY_BMP_ROW__:"):
                    self._send_bmp_row(stripped[len("__DISPLAY_BMP_ROW__:"):])
                elif stripped.startswith("__DISPLAY_BMP__:"):
                    self._send_bmp(stripped[len("__DISPLAY_BMP__:"):])
                elif stripped.startswith("__DISPLAY__:"):
                    self._send_image(stripped[len("__DISPLAY__:"):])
                else:
                    self._send(line)
        except Exception as exc:
            self._send(f"[kernel] stdout read error: {exc}\n", "stderr")

        try:
            proc.wait(timeout=RUN_TIMEOUT)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            self._send(f"\n⏱  Killed after {RUN_TIMEOUT} s timeout.\n", "stderr")

        t.join(timeout=5)
        return proc.returncode, "".join(stderr_lines)

    def _run_gdb_batch(self, binary, print_exprs=None):
        env  = _run_env()
        args = ["gdb", "--batch", "--quiet"]
        for bp in self._breakpoints: args += ["-ex", f"break {bp}"]
        for w  in self._watches:     args += ["-ex", f"watch {w}"]
        args += ["-ex", "run"]
        if self._breakpoints or self._watches:
            args += ["-ex", "info locals", "-ex", "bt 5"]
        for expr in (print_exprs or []):
            args += ["-ex", f"print {expr}"]
        args += ["-ex", "bt", binary]
        r = subprocess.run(args, capture_output=True, text=True,
                           timeout=RUN_TIMEOUT, env=env)
        return r.stdout + r.stderr

    def _format_gdb_output(self, raw):
        out          = []
        re_frame     = re.compile(r'#(\d+)\s+(?:0x\w+ in )?(.+?) \(.*?\) at (.+):(\d+)')
        re_local     = re.compile(r'^(\w+) = (.+)$')
        re_bp_hit    = re.compile(r'Breakpoint \d+,')
        re_watchpt   = re.compile(r'(Old|New) value of `?(.+?)`? =')
        re_signal    = re.compile(r'Program received signal (\w+)')
        re_exited    = re.compile(r'exited (normally|with code (\d+))')
        re_value     = re.compile(r'^\\\$\d+ = (.+)$')
        re_source    = re.compile(r'^(\d+)\s+(.+)$')
        shown_locals = False
        for line in raw.splitlines():
            s = line.strip()
            if not s: continue
            if any(s.startswith(p) for p in (
                "Reading symbols", "(gdb)", "[Inferior", "warning:", "GNU gdb", "No stack."
            )): continue
            m = re_signal.search(s)
            if m:
                explanation = {
                    "SIGSEGV": "Segfault — bad pointer or out-of-bounds index.",
                    "SIGABRT": "Abort — assert() or abort() called.",
                    "SIGFPE":  "Arithmetic error — e.g. division by zero.",
                    "SIGBUS":  "Bus error — misaligned memory access.",
                }.get(m.group(1), f"Signal {m.group(1)}.")
                out.append(f"\n💥  CRASH: {explanation}")
                shown_locals = False
                continue
            m = re_exited.search(s)
            if m:
                out.append(
                    "\n✅  Program finished successfully." if "normally" in m.group(1)
                    else f"\n⚠️   Program exited with code {m.group(2)}."
                )
                continue
            if re_bp_hit.search(s):
                out.append("\n📍  Breakpoint hit:")
                shown_locals = False
                continue
            m = re_watchpt.search(s)
            if m:
                if m.group(1) == "Old":
                    out.append(f"\n👁️   Variable '{m.group(2)}' changed:")
                    out.append(f"     Old: {s.split('=', 1)[1].strip()}")
                else:
                    out.append(f"     New: {s.split('=', 1)[1].strip()}")
                continue
            m = re_frame.match(s)
            if m:
                label = "  ▶  Here:" if m.group(1) == "0" else f"  #{m.group(1)}"
                out.append(f"{label}  {m.group(2)}()  —  line {m.group(4)}")
                continue
            m = re_value.match(s)
            if m:
                out.append(f"\n🔍  Value: {m.group(1)}")
                continue
            if s == "No locals.":
                out.append("     (no local variables)")
                continue
            m = re_source.match(s)
            if m and len(m.group(1)) <= 4:
                out.append(f"     line {m.group(1)}: {m.group(2)}")
                continue
            m = re_local.match(s)
            if m and not s.startswith("#"):
                if not shown_locals:
                    out.append("\n📦  Local variables:")
                    shown_locals = True
                out.append(f"     {m.group(1)} = {m.group(2)}")
                continue
            out.append(s)
        return "\n".join(out) + "\n"

    def _apply_magic(self, magic_lines):
        print_exprs = []
        for line in magic_lines:
            parts = line.split(None, 1)
            cmd   = parts[0]
            arg   = parts[1].strip() if len(parts) > 1 else ""
            if cmd == "%help":
                self._send(HELP_TEXT)
            elif cmd == "%break":
                if not arg:
                    self._send("⚠️  %break needs a line number or function name.\n")
                else:
                    self._breakpoints.append(arg)
                    label = f"line {arg}" if arg.isdigit() else f"function '{arg}'"
                    self._send(f"📍  Breakpoint set at {label}  (total: {len(self._breakpoints)})\n")
            elif cmd == "%watch":
                if not arg:
                    self._send("⚠️  %watch needs a variable name.\n")
                else:
                    self._watches.append(arg)
                    self._send(f"👁️   Watching '{arg}'  (total: {len(self._watches)})\n")
            elif cmd == "%print":
                if not arg:
                    self._send("⚠️  %print needs an expression.\n")
                else:
                    print_exprs.append(arg)
            elif cmd == "%clear":
                self._breakpoints.clear()
                self._watches.clear()
                self._send("🗑️   All breakpoints and watches cleared.\n")
            else:
                self._send(f"⚠️  Unknown command: {cmd}  (try %help)\n")
        return print_exprs

    def do_execute(self, code, silent, store_history=True,
                   user_expressions=None, allow_stdin=False):
        if not GCC_AVAILABLE:
            self._send("❌  gcc not found.\n", "stderr")
            return self._ok()

        lines       = code.strip().splitlines()
        magic_lines = [l.strip() for l in lines if l.strip().startswith("%")]
        src_lines   = [l        for l in lines if not l.strip().startswith("%")]
        src         = "\n".join(src_lines).strip()

        if not src:
            self._apply_magic(magic_lines)
            return self._ok()

        print_exprs = self._apply_magic(magic_lines)
        full_src    = _build_source(src)

        with tempfile.NamedTemporaryFile(
            suffix=".c", delete=False, dir="/tmp", mode="w"
        ) as f:
            f.write(full_src)
            src_path = f.name

        binary_path = src_path.replace(".c", ".out")
        ok, err     = self._compile(src_path, binary_path)

        if not ok:
            self._send("❌  Compilation failed:\n\n" + err, "stderr")
            return self._ok()

        use_gdb = self._breakpoints or self._watches or print_exprs

        if use_gdb:
            if not GDB_AVAILABLE:
                self._send("⚠️   GDB not installed — running without debugger.\n")
                rc, stderr = self._run_streaming(binary_path)
                if stderr:
                    self._send(stderr, "stderr")
            else:
                self._send(self._format_gdb_output(
                    self._run_gdb_batch(binary_path, print_exprs)))
        else:
            rc, stderr = self._run_streaming(binary_path)
            if stderr:
                self._send(stderr, "stderr")
            if rc < 0:
                if GDB_AVAILABLE:
                    self._send("\n💥  Program crashed — running GDB…\n")
                    self._send(self._format_gdb_output(
                        self._run_gdb_batch(binary_path)))
                else:
                    self._send(
                        f"\n💥  Crash (signal {-rc}). Install GDB for a backtrace.\n",
                        "stderr",
                    )

        return self._ok()


if __name__ == "__main__":
    from ipykernel.kernelapp import IPKernelApp
    IPKernelApp.launch_instance(kernel_class=CGDBKernel)
